APP_NAME=Bloome
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_SECURE_COOKIE=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bloome
DB_USERNAME=bloome
DB_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-root-password
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@bloome.local
ADMIN_PASSWORD=

# Ventas: impuesto por defecto (porcentaje) y si está incluido en el precio (1) o se agrega (0). A validar con el centro.
SALES_DEFAULT_TAX_RATE=0
SALES_TAX_INCLUDED=1

# SMTP para recuperación de contraseña (configurar con los datos del proveedor de correo)
MAIL_HOST=mail.bloome.ar
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=soporte@bloome.ar
MAIL_PASSWORD=cambiar-esto-a-contraseña-real
MAIL_FROM=soporte@bloome.ar
MAIL_FROM_NAME=Bloome